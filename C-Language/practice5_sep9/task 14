#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    srand(time(0));
    int x = rand() % 100;
    int y = rand() % 100;
    int z = rand() % 100;

    printf("Initial: X: %d, Y:  %d, Z: %d \n", x, y, z);

    int temp;
    if (x < y) { temp = x; x = y; y = temp; }
    if (x < z) { temp = x; x = z; z = temp; }
    if (y < z) { temp = y; y = z; z = temp; }

    printf("Sorted: X: %d, Y: %d, Z:  %d\n", x, y, z);

    return 0;
}
