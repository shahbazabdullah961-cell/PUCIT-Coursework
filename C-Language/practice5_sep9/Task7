#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int sec;
    printf("Seconds: ");
    scanf("%d", &sec);

    int hrs = sec / 3600;
    int rem = sec % 3600;
    int mins = rem / 60;
    int s = rem % 60;

    printf("Hours: %d\n", hrs);
    printf("Minutes:  %d\n", mins);
    printf("Seconds: %d \n", s);

    if (sec < 60) {
        printf("Less than one minute\n");
    }
    if (sec >= 3600 && sec <= 86400) {
        printf("Within one day range \n");
    }

    return 0;
}
