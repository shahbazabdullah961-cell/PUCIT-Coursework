#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int a, b, c;
    printf("A: ");
    scanf("%d", &a);
    printf("B:  ");
    scanf("%d", &b);
    printf("C: ");
    scanf("%d", &c);

    int valid = (a > 0 && b > 0 && c > 0 && (a + b > c) && (a + c > b) && (b + c > a));

    if (valid && (a == b && b == c)) {
        printf("Valid Equilateral Triangle \n");
    }
    if (valid && ((a == b && a != c) || (b == c && b != a) || (a == c && a != b))) {
        printf("Valid Isosceles Triangle\n");
    }
    if (valid && (a != b && b != c && a != c)) {
        printf("Valid Scalene Triangle \n");
    }
    if (!valid) {
        printf("Invalid Triangle\n");
    }

    return 0;
}
